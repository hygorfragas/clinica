# Supabase (projeto remoto). Copie para .env.local e preencha.
# URL: Settings → API → Project URL (deve começar com https://)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_REF.supabase.co

# Chave anon / publishable (segura para o browser com RLS). Settings → API.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nunca commitar service role. Use só no servidor (ex.: convite do admin da clínica).
# SUPABASE_SERVICE_ROLE_KEY=
