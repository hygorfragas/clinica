# URL pública do app (opcional; recomendado em produção para links de auth / “entrar como”).
# Ex.: https://seu-dominio.com
# NEXT_PUBLIC_APP_URL=

# Supabase (projeto remoto). Copie para .env.local e preencha.
# URL: Settings → API → Project URL (deve começar com https://)
# Obrigatório no painel: Settings → API → Exposed schemas → incluir `clinic`
# (senão o cliente retorna "Invalid schema: clinic" nas queries ao schema clinic.*)
# Prontuário (fotos/PDFs): aplicar migração `supabase/migrations/20260407150000_clinical_storage_bucket.sql`
# para criar o bucket privado `clinical` e políticas de Storage por tenant.
NEXT_PUBLIC_SUPABASE_URL=https://gfeoxbliiomzsfwabfoc.supabase.co

# Chave anon / publishable (segura para o browser com RLS). Settings → API.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_0boJZpjYuTxKMTDuFttrMA_p-ryaoqi

# Nunca commitar service role. Use só no servidor (ex.: convite do admin da clínica).
# SUPABASE_SERVICE_ROLE_KEY=

# Opcional: connection string Postgres (Settings → Database → URI) para rodar
# npm run db:apply-clinical-bucket no ambiente local.
# DATABASE_URL=
