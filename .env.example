# URL pública do app (opcional; recomendado em produção para links de auth / “entrar como”).
# Ex.: https://seu-dominio.com
# NEXT_PUBLIC_APP_URL=

# Banco local (Postgres) para migração Supabase Cloud -> infraestrutura própria.
# Use a string do seu ambiente local (docker/host) em .env.local.
# Ex.: postgres://postgres:postgres@localhost:54322/postgres
# DATABASE_URL=

# Legado de transição (somente enquanto partes do auth ainda usam Supabase Auth).
# Remover após conclusão da fase de cleanup total do SDK.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Storage local (MinIO / S3 compatível).
# Ex.: http://127.0.0.1:9000
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_CLINICAL=clinical

# ---------------------------------------------------------------------------
# Google Calendar (integração da Agenda)
# ---------------------------------------------------------------------------
# 1) No Google Cloud Console: APIs & Services → OAuth consent screen →
#    selecionar External, adicionar escopos Calendar (.readonly e .events) e
#    publicar em produção quando passar em review.
# 2) APIs & Services → Credentials → Create OAuth client ID → Web application.
#    Registrar as origens autorizadas e a redirect URI abaixo.
# 3) Habilitar a Google Calendar API no mesmo projeto.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/agenda/google/callback
# Segredo usado para cifrar o refresh_token do Google antes de salvar no
# Postgres (aes-256-gcm). Gere com: openssl rand -base64 48
# GOOGLE_CALENDAR_SYNC_SECRET=
# (Opcional) Quando for migrar para modo webhook em produção:
# GOOGLE_CALENDAR_WEBHOOK_BASE_URL=https://seu-dominio.com
